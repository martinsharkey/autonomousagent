# ==========================================
# SECURITY & SECRETS
# ==========================================

# HMAC secret for audit log signing (REQUIRED)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
HMAC_SECRET_KEY=your_super_secret_key_here_change_in_production

# HMAC legacy key name (also checked by some modules)
HMAC_KEY=

# ==========================================
# MODEL MANAGEMENT
# ==========================================

# LLM Backend: cloud (default) or local
# cloud: Uses weighted round-robin across cloud providers
# local: Uses local Ollama only
LLM_BACKEND=cloud

# Local Ollama (optional, only if LLM_BACKEND=local)
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_NUM_PARALLEL=1
OLLAMA_CTX_SIZE=2048
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_THREADS=4

# Model configurations are centralized in core/models.py
# All agents use the single source of truth registry

# ==========================================
# CLOUD LLM PROVIDERS (OPTIONAL)
# ==========================================
# Only fill in keys for providers you want to use
# Missing keys = provider stays inactive
# Router uses weighted round-robin across active providers

# High-weight providers (prefer these)
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# Medium-weight providers
DEEPINFRA_API_KEY=
TOGETHER_API_KEY=

# Standard-weight providers
HF_API_KEY=
HUGGINGFACE_TOKEN=
AIHUBMIX_API_KEY=
BIGMODEL_API_KEY=
CEREBRAS_API_KEY=
CLOUDFLARE_WORKERS_AI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
COHERE_API_KEY=
GITHUB_TOKEN=
GOOGLE_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=
GROK_API_KEY=
MISTRAL_API_KEY=
MODELSCOPE_API_KEY=
NVIDIA_NIM_API_KEY=
OLLAMA_API_KEY=
SAMBANOVA_API_KEY=
SILICONFLOW_API_KEY=

# ==========================================
# TELEGRAM CONFIGURATION
# ==========================================

# IMPORTANT: Never share TELEGRAM_BOT_TOKEN with Kilo or other AI assistants
# This token is exclusively for the autonomous council process
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_ALLOWED_USER_IDS=your_user_id_here

# Security Note:
# - TELEGRAM_BOT_TOKEN must NEVER be shared with Kilo Code or any external AI
# - Only the council daemon should have access to this token
# - If you need Kilo for coding help, use a separate bot or chat
# - All council messages use [COUNCIL:SPEAKER] prefix for identity verification

# ==========================================
# AUTONOMY CONTROL
# ==========================================

# Autonomy level (SAFE / LIMITED / FULL)
# SAFE: Manual approval required for all mutations
# LIMITED: Approve low-risk changes automatically
# FULL: Full autonomous operation
AUTONOMY_LEVEL=SAFE

# Enable detailed mutation notifications
MUTATION_NOTIFY_PARAMS=false

# ==========================================
# LOGGING & DEBUG
# ==========================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable detailed governance audit logging
AUDIT_LOG_VERBOSE=false

# ==========================================
# DATA PERSISTENCE
# ==========================================

# Database and log paths
GOALS_DB_PATH=data/goals.db
CONFIG_DB_PATH=data/agent_config.db
AUDIT_LOG_PATH=data/audit.log

# ==========================================
# DEPLOYMENT & FREE INFRASTRUCTURE
# ==========================================

# SnapDeploy API key (optional, for microbot deployments)
SNAPDEPLOY_API_KEY=

# Replit deployment (optional)
REPLIT_TOKEN=
REPLIT_USER=

# HuggingFace Spaces (optional)
HF_API_KEY=

# Railway deployment (optional)
RAILWAY_TOKEN=

# ==========================================
# RUNTIME
# ==========================================

# Sandbox mode (production / development)
SANDBOX_MODE=production

# Council TTL limit (number of retries)
COUNCIL_TTL_LIMIT=5

# Council callback URL for mesh communication
COUNCIL_CALLBACK_URL=http://localhost:8000/api/mesh/result
